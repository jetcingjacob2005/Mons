DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Neon pooled URL; retain the sslmode=require parameter supplied by Neon.
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
AUTHORIZED_ROLE=Mars Reviewer
ADMIN_REVIEW_CHANNEL=admin-review
DEFAULT_KARMA_POINTS=100
MAX_UPLOAD_MB=10
REQUIRED_TAG=#ge-sp-marstrek
AUTO_AWARD=true
# High-risk tasks (wallet, presentation, Figma) are still routed to reviewers.
HIGH_RISK_REVIEW=true
